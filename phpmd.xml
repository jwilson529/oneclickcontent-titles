<?xml version="1.0"?>
<ruleset name="Default PHPMD rules"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 https://pmd.github.io/pmd-6.10.0/ruleset_xml_schema.xsd"
>
    <description>Actionable release rules for the plugin runtime.</description>

    <rule ref="rulesets/codesize.xml">
        <!-- Existing WPPB service classes intentionally centralize hook callbacks. -->
        <exclude name="CyclomaticComplexity" />
        <exclude name="NPathComplexity" />
        <exclude name="ExcessiveMethodLength" />
        <exclude name="ExcessiveClassLength" />
        <exclude name="ExcessiveClassComplexity" />
        <exclude name="ExcessiveParameterList" />
        <exclude name="TooManyMethods" />
        <exclude name="TooManyPublicMethods" />
    </rule>
    <rule ref="rulesets/unusedcode.xml">
        <!-- Private static callbacks passed by class name are not detected as calls. -->
        <exclude name="UnusedPrivateMethod" />
    </rule>
    <rule ref="rulesets/naming.xml" />
</ruleset>
